# ThingsBoard REST address. Do not add /api at the end.
TB_BASE_URL=https://thingsboard.cloud

# ThingsBoard dashboard/tenant account used only by the local Node server.
TB_USERNAME=almaru.zaim1506@gmail.com
TB_PASSWORD=REPLACE_WITH_PASSWORD

# Prefer the immutable device ID. If it is empty, TB_DEVICE_NAME is resolved.
TB_DEVICE_ID=eb5a9bd0-8a1b-11f1-a3bc-95bc3f4b3917
TB_DEVICE_NAME=Monitoring AAT

# Dashboard API server configuration.
API_PORT=3001
TB_STALE_AFTER_MS=30000
